# Copy to .env.local for local overrides, or set in Vercel → Settings → Environment Variables.
# Vite bakes VITE_* at build time — redeploy the frontend after changing these.

# Public HTTPS origin of the hosted Node/Socket.io backend (no trailing slash).
# Required for production on Vercel (the SPA host has no Socket.io server).
VITE_SOCKET_URL=https://your-backend.onrender.com

# Optional. Defaults to VITE_SOCKET_URL when unset. Used for /api REST calls.
VITE_API_URL=https://your-backend.onrender.com
